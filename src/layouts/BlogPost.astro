---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { eyebrow?: string; showDate?: boolean };

const { title, description, pubDate, updatedDate, heroImage, eyebrow = 'THE BRIEFING', showDate = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main id="top" class="max-w-[1380px] mx-auto px-5 md:px-10 xl:px-14">
			<article class="max-w-[760px] mx-auto py-10 md:py-16">
				<div class="flex flex-wrap items-center gap-3 eyebrow text-rust">
					<span class="bg-rust text-white px-2.5 py-1.5">{eyebrow}</span>
					{showDate && <FormattedDate date={pubDate} />}
				</div>
				<h1 class="display text-[clamp(38px,6vw,72px)] leading-[1] tracking-[-.05em] mt-6">{title}</h1>
				<p class="display text-[clamp(19px,2.4vw,26px)] leading-[1.25] tracking-[-.01em] text-[#62605d] mt-5">{description}</p>
				<div class="mt-7 pt-4 border-t hairline flex flex-wrap justify-between gap-3 text-[11px] mono text-muted">
					<span>BY THE INTELLIGENCE DESK</span>
					{
						updatedDate && (
							<span>
								UPDATED <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>
				{heroImage && <img class="w-full mt-8" width={1020} height={510} src={heroImage} alt="" />}
				<div class="article-body mt-10">
					<slot />
				</div>
				<div class="mt-14 pt-6 border-t border-ink flex flex-wrap justify-between gap-4">
					<a href="/blog/" class="text-[11px] font-bold uppercase tracking-wider border-b border-rust pb-1 hover:text-rust">← Back to the archive</a>
					<a href="mailto:editor@thetrendtimes.com" class="text-[11px] mono text-muted hover:text-rust">TIPS → EDITOR@THETRENDTIMES.COM</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
