---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES, readMinutes } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const cover = posts.find((p) => p.data.featured) ?? posts[0];
const others = posts.filter((p) => p !== cover);
const moreBriefings = others.slice(0, 5);
const latest = others.slice(0, 6);
const colClass = ['md:pr-7 md:border-r', 'md:px-7 md:border-r', 'md:pl-7'];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | Signals, Not Noise.`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header home />

		<main id="top" class="max-w-[1380px] mx-auto px-5 md:px-10 xl:px-14">
			<div class="flex flex-wrap justify-between gap-2 pt-6 pb-5 text-[10px] mono text-muted uppercase">
				<span><span class="text-rust">●</span> THE LATEST BRIEFING</span>
				<span>{posts.length} BRIEFINGS PUBLISHED</span>
			</div>

			<section class="grid lg:grid-cols-[minmax(0,1.8fr)_minmax(300px,.85fr)] gap-0 border-y border-ink">
				<article class="lg:pr-10 xl:pr-14 py-8 md:py-11 story-link">
					{cover ? (
						<>
							<div class="flex flex-wrap items-center gap-3 eyebrow text-rust">
								<span class="bg-rust text-white px-2.5 py-1.5">THE COVER STORY</span><span>{CATEGORIES[cover.data.category].toUpperCase()} / {fmt(cover.data.pubDate)}</span>
							</div>
							<a href={`/blog/${cover.id}/`} class="block">
								<h1 class="story-title display text-[clamp(40px,6.3vw,91px)] leading-[.98] tracking-[-.055em] mt-6 sm:mt-7 max-w-[900px]">{cover.data.title}</h1>
								<p class="display text-[clamp(20px,2.5vw,33px)] leading-[1.16] tracking-[-.02em] mt-5 text-[#62605d] max-w-[780px]">{cover.data.description}</p>
							</a>
							{cover.data.sources.length > 0 && (
								<div class="mt-8 flex flex-wrap items-center gap-2">
									<span class="eyebrow text-muted mr-2 w-full sm:w-auto">EVIDENCE TRAIL</span>
									{cover.data.sources.slice(0, 4).map((s) => (
										<a href={s.url} rel="noopener" target="_blank" class="text-[10px] mono border hairline rounded-full px-3 py-2 hover:text-rust">↗ {s.label}</a>
									))}
								</div>
							)}
							<div class="mt-9 pt-5 border-t hairline flex flex-wrap items-center justify-between gap-4">
								<span class="text-[11px] mono text-muted">BY {cover.data.author.toUpperCase()} <span class="mx-2">/</span> {readMinutes(cover.body)} MIN READ</span>
								<a href={`/blog/${cover.id}/`} class="text-[11px] font-bold uppercase tracking-wider border-b border-rust pb-1 hover:text-rust">Read the report ↗</a>
							</div>
						</>
					) : (
						<>
							<div class="flex flex-wrap items-center gap-3 eyebrow text-rust">
								<span class="bg-rust text-white px-2.5 py-1.5">ISSUE 001</span><span>IN PREPARATION</span>
							</div>
							<h1 class="story-title display text-[clamp(40px,6.3vw,91px)] leading-[.98] tracking-[-.055em] mt-6 sm:mt-7 max-w-[900px]">The first briefing is in the works.</h1>
							<p class="mt-6 text-sm sm:text-[15px] text-[#575a5d] leading-[1.8] max-w-[710px]">We publish only after the sources check out. Read how we work, or send us a tip.</p>
							<div class="mt-9 pt-5 border-t hairline flex flex-wrap items-center gap-4">
								<a href="/about/" class="text-[11px] font-bold uppercase tracking-wider border-b border-rust pb-1 hover:text-rust">Our method ↗</a>
								<a href="/contact/" class="text-[11px] font-bold uppercase tracking-wider border-b border-rust pb-1 hover:text-rust">Send a tip ↗</a>
							</div>
						</>
					)}
				</article>

				<aside class="lg:border-l hairline lg:pl-8 xl:pl-10 py-8 md:py-11 border-t lg:border-t-0" aria-labelledby="more-title">
					<div class="flex items-center justify-between">
						<span class="eyebrow text-rust">ALSO THIS MONTH</span><span class="mono text-[10px] text-muted">{String(moreBriefings.length).padStart(2, '0')}</span>
					</div>
					<h2 id="more-title" class="display text-[32px] leading-none tracking-tight mt-4">More briefings.</h2>
					<div class="mt-6">
						{moreBriefings.length === 0 && <p class="text-xs text-muted leading-relaxed">New briefings will appear here as they are published.</p>}
						{moreBriefings.map((p, i) => (
							<div class={`py-4 ${i === moreBriefings.length - 1 ? 'border-y' : 'border-t'} hairline`}>
								<a href={`/blog/${p.id}/`} class="flex gap-3 hover:text-rust">
									<span class="display text-2xl text-rust">{String(i + 1).padStart(2, '0')}</span>
									<div class="flex-1">
										<h3 class="font-semibold text-[13px]">{p.data.title}</h3>
										<p class="text-[11px] text-muted mt-1">{CATEGORIES[p.data.category]}, {fmt(p.data.pubDate)}</p>
									</div>
								</a>
							</div>
						))}
					</div>
				</aside>
			</section>

			<section id="story-preview" class="grid md:grid-cols-[1fr_1.4fr] gap-5 md:gap-12 py-9 md:py-12 border-b hairline">
				<div>
					<span class="eyebrow text-rust">THE EDITOR'S NOTE</span>
					<h2 class="display text-[34px] sm:text-[42px] leading-[1.05] mt-3 tracking-tight">Follow the friction.<br /><em>Find the market.</em></h2>
				</div>
				<div class="md:pt-5">
					<p class="text-sm leading-[1.9] text-[#52565a]">The next breakout business might look boring from the outside. Our cover investigation maps the workflows people repeatedly complain about, the tools they currently stitch together, and the signals that suggest willingness to pay. We separate attention from intent, and intent from actual spending.</p>
					<a href="/blog/" class="inline-block mt-5 text-[11px] font-bold uppercase tracking-wider border-b border-rust pb-1 hover:text-rust">Browse the archive ↗</a>
				</div>
			</section>

			<section id="latest" class="py-12 md:py-16 scroll-mt-4">
				<div class="flex flex-wrap items-end justify-between gap-4 mb-7">
					<div>
						<div class="eyebrow text-rust mb-3">BEYOND THE HEADLINES</div>
						<h2 class="display text-[40px] sm:text-[56px] tracking-[-.045em] leading-none">Latest intelligence<span class="text-rust">.</span></h2>
					</div>
					<span class="mono text-[10px] text-muted">CURATED / NOT GENERATED</span>
				</div>
				<div class="filter-row flex gap-2 mb-7 -mx-5 px-5 sm:mx-0 sm:px-0 overflow-x-auto sm:flex-wrap" role="group" aria-label="Filter reports">
					<button type="button" class="filter-btn shrink-0 rounded-full border hairline px-4 py-2 text-[11px] font-semibold" data-filter="all" aria-pressed="true">All reports</button>
					<button type="button" class="filter-btn shrink-0 rounded-full border hairline px-4 py-2 text-[11px] font-semibold" data-filter="agents" aria-pressed="false">AI Agents</button>
					<button type="button" class="filter-btn shrink-0 rounded-full border hairline px-4 py-2 text-[11px] font-semibold" data-filter="saas" aria-pressed="false">Micro-SaaS</button>
					<button type="button" class="filter-btn shrink-0 rounded-full border hairline px-4 py-2 text-[11px] font-semibold" data-filter="sentiment" aria-pressed="false">Raw Sentiment</button>
					<button type="button" class="filter-btn shrink-0 rounded-full border hairline px-4 py-2 text-[11px] font-semibold" data-filter="market" aria-pressed="false">Market Signals</button>
				</div>

				<div class="grid md:grid-cols-3 border-t border-ink" id="report-grid">
					{latest.map((p, i) => (
						<article data-category={p.data.category} class={`report-card story-link py-7 ${colClass[i % 3]} hairline border-b`}>
							<a href={`/blog/${p.id}/`} class="block">
								<div class="flex justify-between eyebrow text-rust"><span>{CATEGORIES[p.data.category].toUpperCase()}</span><span class="text-muted">{String(readMinutes(p.body)).padStart(2, '0')} MIN</span></div>
								{p.data.heroImage && (
									<div class="mt-7 mb-6 aspect-[2/1] overflow-hidden bg-sand">
										<img class="w-full h-full object-cover" width={720} height={360} src={p.data.heroImage} alt="" loading="lazy" />
									</div>
								)}
								<h3 class="story-title display text-[25px] sm:text-[27px] leading-[1.14] tracking-tight mt-5">{p.data.title}</h3>
								<p class="text-[13px] text-muted leading-relaxed mt-3">{p.data.description}</p>
								<p class="mono text-[10px] mt-5 text-rust">{fmt(p.data.pubDate)} ↗</p>
							</a>
						</article>
					))}
				</div>
				<p id="filter-empty" class="text-sm text-muted py-8" hidden={latest.length > 0}>No reports in this section yet. New briefings appear here as they are published.</p>
				<p id="filter-status" class="sr-only" aria-live="polite">Showing all reports</p>
			</section>

			<section id="methodology" class="py-12 md:py-16 grid md:grid-cols-[.9fr_1.1fr] gap-8 md:gap-16 border-b hairline scroll-mt-4">
				<div>
					<span class="eyebrow text-rust">THE TTT STANDARD</span>
					<h2 class="display text-[38px] md:text-[48px] leading-[1.05] tracking-tight mt-4">Less hype.<br />More evidence.</h2>
				</div>
				<div class="grid sm:grid-cols-3 gap-6">
					<div class="flex sm:block gap-4"><div class="display text-4xl text-rust">01</div><div><h3 class="font-semibold text-sm sm:mt-3">Listen</h3><p class="text-xs leading-[1.7] text-muted mt-2">Look for recurring pain across Reddit, X, Hacker News, and builder communities.</p></div></div>
					<div class="flex sm:block gap-4"><div class="display text-4xl text-rust">02</div><div><h3 class="font-semibold text-sm sm:mt-3">Cross-check</h3><p class="text-xs leading-[1.7] text-muted mt-2">Compare conversation velocity with repositories, pricing, and observable behavior.</p></div></div>
					<div class="flex sm:block gap-4"><div class="display text-4xl text-rust">03</div><div><h3 class="font-semibold text-sm sm:mt-3">Distill</h3><p class="text-xs leading-[1.7] text-muted mt-2">Publish the useful takeaway, confidence level, and what remains unproven.</p></div></div>
				</div>
			</section>

			<section id="newsletter" class="py-14 md:py-20 scroll-mt-4">
				<div class="bg-ink text-white -mx-5 sm:mx-0 px-6 py-10 sm:px-12 sm:py-14 md:px-16 md:py-16 grid lg:grid-cols-[1fr_.8fr] gap-9 lg:gap-16 items-center">
					<div>
						<div class="eyebrow text-[#dca88d]">THE WEEKLY SIGNAL / FREE EDITION</div>
						<h2 class="display text-[38px] sm:text-[58px] leading-[1.02] tracking-[-.045em] mt-5">The internet is loud.<br /><em>Stay ahead of it.</em></h2>
						<p class="text-white/65 text-sm leading-[1.8] mt-5 max-w-[520px]">One carefully filtered briefing every week: overlooked markets, validated pain points, and the technology shifts worth your attention.</p>
					</div>
					<div>
						<form id="newsletter-form" class="space-y-3" novalidate>
							<label for="email" class="block mono text-[10px] tracking-wider text-white/70 uppercase">Your email address</label>
							<div class="flex flex-col sm:flex-row gap-2">
								<input id="email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@company.com" class="min-w-0 flex-1 bg-white text-ink px-4 py-4 text-base sm:text-sm rounded-none placeholder:text-[#999]" />
								<button type="submit" class="bg-[#bc7050] hover:bg-[#a45137] text-white px-6 py-4 text-[11px] font-bold uppercase tracking-widest whitespace-nowrap">Get the signal ↗</button>
							</div>
							<p id="form-message" role="status" aria-live="polite" class="text-xs text-white/65 min-h-5">Free to read. Built for curious minds. Unsubscribe anytime.</p>
						</form>
						<div class="border-t border-white/20 mt-8 pt-5 flex flex-wrap gap-4 justify-between mono text-[10px] text-white/55">
							<span>ONE EMAIL A WEEK</span><span>UNSUBSCRIBE ANYTIME</span>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
