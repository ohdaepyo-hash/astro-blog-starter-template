---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pains = [
	['Missing bank statements dragging past the 15th', 'You can’t reconcile what you don’t have, so the close slips every month.'],
	['Incomplete receipt photos buried in WhatsApp, SMS, and scattered emails', 'Half a receipt in one thread, the other half in a text from last Tuesday.'],
	['Being the “annoying nag” just to do your job', 'Every follow-up costs you time and a little goodwill with the client.'],
];
const steps = [
	['Send one magic checklist link per client', 'List what you need this month. The client gets one link, not another email thread.'],
	['Client drops files directly on their phone', 'No account required. They tap the item, snap the photo, done.'],
	['DocChase sends scheduled, polite reminders', 'Nudges go out on your schedule until all items are checked off. You stop being the nag.'],
];
const groups = [
	['doc', 'Missing document', [['bank', 'Bank Statements'], ['receipts', 'Credit Card Receipts'], ['w9', 'W-9 / Tax Forms'], ['invoices', 'Missing Invoices']]],
	['days', 'Days overdue', [['3', '3 Days (Gentle Check-in)'], ['7', '7 Days (Follow-up)'], ['14', '14+ Days (Month-end Closing)']]],
	['tone', 'Tone', [['warm', 'Warm & Friendly'], ['firm', 'Firm & Professional'], ['urgent', 'Urgent (Tax Deadline)']]],
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="DocChase | Stop Chasing Receipts Through 15 Email Threads"
			description="One magic checklist link per bookkeeping client. Zero logins, zero apps. Automated gentle nudges until month-end is closed."
		/>
	</head>
	<body>
		<Header />

		<main id="top" class="dc">
			<section class="hero">
				<span class="eyebrow text-rust">THE TREND TIMES TOOLS / DOCCHASE / EARLY ACCESS</span>
				<h1 class="display">Stop Chasing Receipts Through 15 Email Threads.</h1>
				<p class="lede">
					DocChase gives your bookkeeping clients one magic checklist link. Zero logins, zero apps to install.
					Automated gentle nudges until month-end is closed.
				</p>
				<form class="wl" data-waitlist novalidate>
					<label for="hero-email" class="sr-only">Your work email</label>
					<input id="hero-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@yourfirm.com" />
					<input name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
					<button type="submit">Get Early Access (50% Off Lifetime)</button>
					<p role="status" aria-live="polite" class="msg">For solo bookkeepers, small firms, and fractional CFOs.</p>
				</form>
			</section>

			<section class="band demo" aria-labelledby="demo-title">
				<span class="eyebrow text-rust">TRY IT: 3-SECOND DEMO</span>
				<h2 id="demo-title" class="display">Write this month’s nudge in one click.</h2>
				<form class="nudge card" data-nudge>
					{groups.map(([name, legend, opts]) => (
						<fieldset>
							<legend>{legend}</legend>
							<div class="pills">
								{opts.map(([value, label], i) => (
									<label><input type="radio" name={name} value={value} checked={i === 0} /><span>{label}</span></label>
								))}
							</div>
						</fieldset>
					))}
					<label class="name">Client name <span>(optional)</span>
						<input name="client" type="text" maxlength="40" placeholder="Alex" autocomplete="off" />
					</label>
					<button type="submit">Generate Nudge</button>
				</form>
				<div class="out" data-out hidden>
					<div class="mail">
						<div class="mhead"><span>Subject</span><strong data-subject></strong></div>
						<pre data-body></pre>
						<button type="button" class="copy" data-copy>Copy to Clipboard</button>
					</div>
					<p class="upsell">
						Tired of manually copying and sending this 15 times every month? DocChase automates the entire chase on autopilot with zero client logins.
						<a href="#waitlist" data-to-waitlist>Lock in $9/mo Lifetime Pricing -&gt;</a>
					</p>
				</div>
			</section>

			<section class="band">
				<span class="eyebrow text-rust">THE MONTH-END REALITY</span>
				<h2 class="display">Your close is waiting on someone else’s camera roll.</h2>
				<div class="grid3">
					{pains.map(([t, d], i) => (
						<div class="card">
							<div class="num display">0{i + 1}</div>
							<h3>{t}</h3>
							<p>{d}</p>
						</div>
					))}
				</div>
			</section>

			<section class="band">
				<span class="eyebrow text-rust">HOW IT WORKS</span>
				<h2 class="display">Three steps. Nothing for your client to install.</h2>
				<ol class="grid3">
					{steps.map(([t, d], i) => (
						<li class="card">
							<div class="num display">Step {i + 1}</div>
							<h3>{t}</h3>
							<p>{d}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="band">
				<span class="eyebrow text-rust">PLANNED PRICING</span>
				<h2 class="display">Priced for a practice of one, or a few.</h2>
				<div class="grid2">
					<div class="card price">
						<h3>Solo Bookkeeper</h3>
						<div class="amt display">$19<span>/mo</span></div>
						<p>Up to 30 active clients</p>
					</div>
					<div class="card price">
						<h3>Small Firm</h3>
						<div class="amt display">$49<span>/mo</span></div>
						<p>Unlimited clients + custom branding</p>
					</div>
				</div>
				<p class="early"><strong>Early bird:</strong> Join the waitlist now for $9/mo lifetime founder pricing.</p>
			</section>

			<section id="waitlist" class="cta">
				<div class="eyebrow">DOCCHASE WAITLIST</div>
				<h2 class="display">Close the month without the chase.</h2>
				<form class="wl" data-waitlist novalidate>
					<label for="cta-email" class="sr-only">Your work email</label>
					<input id="cta-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@yourfirm.com" />
					<input name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
					<button type="submit">Join Waitlist</button>
					<p role="status" aria-live="polite" class="msg">$9/mo lifetime founder pricing for waitlist members. One email when we open access.</p>
				</form>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.dc{max-width:1100px;margin:0 auto;padding:0 20px}
	.hero{padding:56px 0 64px;border-bottom:1px solid var(--ink)}
	.hero h1{font-size:clamp(40px,6.3vw,84px);line-height:.98;letter-spacing:-.05em;margin-top:24px;max-width:900px}
	.lede{font-size:clamp(17px,2vw,22px);line-height:1.5;color:#52565a;margin-top:24px;max-width:720px}
	.band{padding:56px 0;border-bottom:1px solid var(--line)}
	.band h2,.cta h2{font-size:clamp(30px,4.2vw,48px);line-height:1.05;letter-spacing:-.03em;margin-top:14px;max-width:760px}
	.grid3,.grid2{display:grid;gap:20px;margin-top:32px}
	@media(min-width:768px){.grid3{grid-template-columns:repeat(3,1fr)}.grid2{grid-template-columns:repeat(2,1fr);max-width:760px}}
	.card{background:#f5f1ea;padding:24px}
	.card .num{font-size:30px;color:var(--rust)}
	.card h3{font-weight:600;font-size:16px;line-height:1.35;margin-top:10px}
	.card p{font-size:14px;line-height:1.7;color:var(--muted);margin-top:8px}
	.amt{font-size:52px;letter-spacing:-.04em;margin-top:8px}
	.amt span{font-size:18px;color:var(--muted)}
	.early{margin-top:24px;padding:16px 20px;border-left:3px solid var(--rust);background:#fff;max-width:760px}
	.cta{background:var(--ink);color:#fff;margin:56px -20px;padding:48px 24px}
	@media(min-width:640px){.cta{margin:56px 0;padding:64px 56px}}
	.cta .eyebrow{color:#dca88d}
	.wl{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px;max-width:640px}
	.wl input[type=email]{flex:1 1 240px;min-width:0;padding:16px;font-size:16px;background:#fff;color:var(--ink);border:1px solid var(--ink)}
	.wl button{background:#a45137;color:#fff;padding:16px 22px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
	.wl button:hover{background:#8a3f2a}
	.wl button:disabled{opacity:.6}
	.msg{flex-basis:100%;font-size:13px;color:var(--muted);min-height:20px}
	.cta .msg{color:rgba(255,255,255,.7)}
	.msg.ok{color:#2f6b3a}
	.cta .msg.ok{color:#e7b798}
	.hp{position:absolute;left:-9999px;width:1px;height:1px}
	.demo h2{max-width:none}
	.nudge{display:grid;gap:20px;margin-top:28px;border:1px solid var(--ink)}
	.nudge fieldset{border:0;padding:0;margin:0}
	.nudge legend,.name{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
	.pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
	.pills input{position:absolute;opacity:0}
	.pills span{display:block;padding:10px 14px;font-size:14px;background:#fff;border:1px solid var(--line);cursor:pointer}
	.pills input:checked+span{background:var(--ink);color:#fff;border-color:var(--ink)}
	.pills input:focus-visible+span{outline:2px solid var(--rust);outline-offset:2px}
	.name span{font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted)}
	.name input{display:block;margin-top:10px;width:100%;max-width:320px;padding:12px;font-size:16px;background:#fff;border:1px solid var(--ink);text-transform:none;letter-spacing:0;font-weight:400}
	.nudge>button,.copy{justify-self:start;background:#a45137;color:#fff;padding:16px 22px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
	.nudge>button:hover,.copy:hover{background:#8a3f2a}
	.out{margin-top:20px;animation:rise .35s ease-out}
	@keyframes rise{from{opacity:0;transform:translateY(12px)}}
	@media(prefers-reduced-motion:reduce){.out{animation:none}}
	.mail{background:#fff;border:1px solid var(--ink);padding:0 0 20px}
	.mhead{display:flex;gap:12px;align-items:baseline;padding:16px 20px;border-bottom:1px solid var(--line)}
	.mhead span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
	.mail pre{white-space:pre-wrap;font:inherit;font-size:15px;line-height:1.7;padding:20px;margin:0}
	.copy{margin-left:20px}
	.upsell{margin-top:16px;padding:20px;background:var(--ink);color:#fff;line-height:1.6}
	.upsell a{display:block;margin-top:8px;color:#e7b798;font-weight:700}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
			const msg = form.querySelector('.msg')!;
			const button = form.querySelector('button')!;
			if (!input.checkValidity()) return input.reportValidity();
			button.disabled = true;
			try {
				const res = await fetch('/api/waitlist', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ email: input.value, company: (form.elements.namedItem('company') as HTMLInputElement).value }),
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
				msg.textContent = 'You’re on the list. Founder pricing ($9/mo lifetime) is locked to this email.';
				msg.classList.add('ok');
				form.reset();
			} catch (err) {
				msg.textContent = err instanceof TypeError ? 'Network error. Please try again.' : (err as Error).message;
			} finally {
				button.disabled = false;
			}
		});
	});

	// ponytail: fixed templates, no LLM. 4 docs x 3 stages x 3 tones, composed in the browser.
	const DOCS = {
		bank: { short: 'bank statements', why: 'reconcile your accounts', ask: (m: string) => `PDF statements for every business checking, savings, and credit card account for ${m}. The PDF from your bank's website works best, since screenshots can miss pages.` },
		receipts: { short: 'credit card receipts', why: 'categorize your card spending', ask: (m: string) => `Receipts for the ${m} card charges I flagged. A clear phone photo of each one is fine. If a receipt is lost, a one-line note with the vendor, amount, and business purpose works for now.` },
		w9: { short: 'W-9 and tax forms', why: 'file your 1099s', ask: () => `A signed W-9 for each contractor you paid this year, plus any 1099s or tax notices that came in the mail.` },
		invoices: { short: 'missing invoices', why: 'match payments to the right customers and vendors', ask: (m: string) => `Copies of the ${m} invoices that aren't in the books yet, both the ones you sent and the bills you received.` },
	};
	const STAGES = {
		'3': { subj: 'Quick check-in', line: (d: string, m: string) => `Quick check-in on the ${d} for ${m}.` },
		'7': { subj: 'Following up', line: (d: string, m: string) => `Following up on my note from last week about the ${d} for ${m}. I haven't received them yet.` },
		'14': { subj: 'Month-end close', line: (d: string, m: string) => `It's been two weeks since I asked for the ${d} for ${m}, and they're the last item holding up your month-end close.` },
	};
	const dateIn = (n: number, o: Intl.DateTimeFormatOptions) => new Date(Date.now() + n * 864e5).toLocaleDateString('en-US', o);
	const TONES = {
		warm: { open: 'Hope your week is going well.', subj: () => '', close: () => `Whenever you have a few minutes this week is perfect. If anything is hard to find, reply here and we'll sort it out together.`, sign: 'Thanks so much,' },
		firm: { open: '', subj: () => ` (needed by ${dateIn(3, { month: 'short', day: 'numeric' })})`, close: () => `Please send these by ${dateIn(3, { weekday: 'long', month: 'long', day: 'numeric' })}. If something is missing, send what you have and tell me what's outstanding.`, sign: 'Best regards,' },
		urgent: { open: 'I need your help with a tax deadline.', subj: () => ` - due ${dateIn(2, { month: 'short', day: 'numeric' })}`, close: (why: string) => `Please send these by ${dateIn(2, { weekday: 'long', month: 'long', day: 'numeric' })}. Without them I can't ${why} before the deadline, which can mean an extension or late-filing penalties.`, sign: 'Thank you,' },
	};

	const nudge = document.querySelector<HTMLFormElement>('form[data-nudge]')!;
	const out = document.querySelector<HTMLElement>('[data-out]')!;
	const copyBtn = out.querySelector<HTMLButtonElement>('[data-copy]')!;
	let mail = '';
	nudge.addEventListener('submit', (e) => {
		e.preventDefault();
		const f = new FormData(nudge);
		const doc = DOCS[f.get('doc') as keyof typeof DOCS];
		const stage = STAGES[f.get('days') as keyof typeof STAGES];
		const tone = TONES[f.get('tone') as keyof typeof TONES];
		const name = String(f.get('client') || '').trim() || 'Alex';
		const now = new Date();
		const month = new Date(now.getFullYear(), now.getMonth() - 1).toLocaleDateString('en-US', { month: 'long' });
		const subject = `${stage.subj}: ${month} ${doc.short}${tone.subj()}`;
		const body = [`Hi ${name},`, [tone.open, stage.line(doc.short, month)].filter(Boolean).join(' '), `What I need:\n${doc.ask(month)}`, tone.close(doc.why), `${tone.sign}\n[Your Name]`].join('\n\n');
		out.querySelector('[data-subject]')!.textContent = subject;
		out.querySelector('[data-body]')!.textContent = body;
		mail = `Subject: ${subject}\n\n${body}`;
		copyBtn.textContent = 'Copy to Clipboard';
		out.hidden = true;
		void out.offsetWidth; // restart the reveal animation on every generate
		out.hidden = false;
	});
	copyBtn.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(mail);
			copyBtn.textContent = 'Copied!';
		} catch {
			copyBtn.textContent = 'Copy failed. Select the text manually.';
		}
	});
	out.querySelector('[data-to-waitlist]')!.addEventListener('click', (e) => {
		e.preventDefault();
		document.getElementById('waitlist')!.scrollIntoView({ behavior: 'smooth' });
		document.getElementById('cta-email')!.focus({ preventScroll: true });
	});
</script>
