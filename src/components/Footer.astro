---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink">
	<div class="max-w-[1380px] mx-auto px-5 md:px-10 xl:px-14 py-11">
		<div class="flex flex-col md:flex-row md:justify-between gap-9">
			<div>
				<a href="/" class="display text-3xl tracking-[-.055em] font-semibold">THE TREND TIMES</a>
				<p class="text-xs text-muted mt-2">Signals, Not Noise.</p>
				<p class="text-[11px] text-muted mt-4 max-w-sm leading-relaxed">Independent technology intelligence for founders, builders, and investors who value evidence over attention.</p>
			</div>
			<div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-x-10 gap-y-3 text-[11px] font-semibold uppercase tracking-wider">
				<div class="flex flex-col gap-3">
					<a href="/about/" class="hover:text-rust">About / Method</a>
					<a href="/contact/" class="hover:text-rust">Contact</a>
					<a href="mailto:editor@thetrendtimes.com" class="hover:text-rust">Send a Tip</a>
				</div>
				<div class="flex flex-col gap-3">
					<a href="/blog/" class="hover:text-rust">Archive</a>
					<a href="/rss.xml" class="hover:text-rust">RSS ↗</a>
				</div>
				<div class="flex flex-col gap-3">
					<a href="/privacy/" class="hover:text-rust">Privacy Policy</a>
					<a href="/terms/" class="hover:text-rust">Terms of Use</a>
					<a href="/disclaimer/" class="hover:text-rust">Disclaimer</a>
				</div>
			</div>
		</div>
		<div class="mt-10 pt-5 border-t hairline flex flex-wrap justify-between gap-4 text-[10px] mono text-muted">
			<span>© <span id="year">{year}</span> THE TREND TIMES / THETRENDTIMES.COM</span>
			<span>BUILT FOR THE OPEN WEB <span class="text-ink">/ ASTRO ◇ CLOUDFLARE</span></span>
		</div>
		<p class="text-[10px] text-muted mt-4 leading-relaxed">Nothing on this site is investment, legal, or financial advice. See our <a href="/disclaimer/" class="underline underline-offset-4 hover:text-rust">Disclaimer</a>.</p>
	</div>
</footer>

<script>
	const now = new Date();
	const dateEl = document.getElementById('issue-date');
	if (dateEl) {
		dateEl.textContent = new Intl.DateTimeFormat('en-US', {
			month: 'long',
			day: '2-digit',
			year: 'numeric',
			timeZone: 'Asia/Seoul',
		})
			.format(now)
			.toUpperCase();
	}
	const yearEl = document.getElementById('year');
	if (yearEl) yearEl.textContent = String(now.getFullYear());

	// Mobile menu
	const menu = document.getElementById('mobile-menu');
	const toggle = document.getElementById('menu-toggle');
	const setMenu = (open: boolean) => {
		if (!menu || !toggle) return;
		toggle.setAttribute('aria-expanded', String(open));
		menu.hidden = !open;
	};
	toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
	menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setMenu(false);
	});
	window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
		if (e.matches) setMenu(false);
	});

	// Report filters (homepage only)
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
	const cards = Array.from(document.querySelectorAll<HTMLElement>('.report-card'));
	const status = document.getElementById('filter-status');
	const filter = (category: string) => {
		if (!buttons.length) return;
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === category)));
		let visible = 0;
		cards.forEach((c) => {
			const show = category === 'all' || c.dataset.category === category;
			c.classList.toggle('card-hidden', !show);
			if (show) visible++;
		});
		const label = buttons.find((b) => b.dataset.filter === category)?.textContent?.trim() || category;
		if (status) status.textContent = `Showing ${visible} reports in ${label}`;
		const empty = document.getElementById('filter-empty');
		if (empty) empty.hidden = visible > 0;
	};
	buttons.forEach((b) => b.addEventListener('click', () => filter(b.dataset.filter || 'all')));
	const initial = new URLSearchParams(location.search).get('c');
	if (initial) filter(initial);
	document.querySelectorAll<HTMLElement>('[data-nav-filter]').forEach((a) =>
		a.addEventListener('click', () => filter(a.dataset.navFilter || 'all')),
	);

	// Newsletter: hand off to the reader's mail app (contact@ forwards to the editors)
	const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const input = document.getElementById('email') as HTMLInputElement;
		const message = document.getElementById('form-message');
		if (!input.checkValidity()) {
			input.reportValidity();
			return;
		}
		const subject = encodeURIComponent('Subscribe: The Weekly Signal');
		const body = encodeURIComponent(`Please add ${input.value} to The Weekly Signal.`);
		window.location.href = `mailto:contact@thetrendtimes.com?subject=${subject}&body=${body}`;
		if (message) {
			message.textContent = 'Your mail app should open with a ready-to-send request. Just hit send and you are on the list.';
			message.className = 'text-xs text-[#e7b798] min-h-5';
		}
	});
</script>
