---
interface Props {
	home?: boolean;
}

const { home = false } = Astro.props;
const p = home ? '' : '/';
const today = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: '2-digit',
	year: 'numeric',
	timeZone: 'Asia/Seoul',
})
	.format(new Date())
	.toUpperCase();
---

<a href="#top" class="skip-link">Skip to content</a>
<div class="bg-ink text-white text-[10px] sm:text-[11px] py-2.5 px-4 text-center tracking-[.09em]">
	<span class="hidden sm:inline">INDEPENDENT INTELLIGENCE FOR PEOPLE BUILDING WHAT'S NEXT</span><span class="sm:hidden">FOR PEOPLE BUILDING WHAT'S NEXT</span>
	<span class="text-[#d99a77] ml-2">✳</span>
	<span class="hidden lg:inline text-white/55 ml-2">A 30-DAY WINDOW INTO REAL DEMAND</span>
</div>
<header class="max-w-[1380px] mx-auto px-5 md:px-10 xl:px-14">
	<div class="flex justify-between items-center py-4 border-b hairline text-[10px] sm:text-xs text-muted mono gap-3">
		<span>VOL. 1 · NO. 1 <span class="hidden sm:inline">/ GLOBAL EDITION</span></span>
		<span class="hidden md:inline">THE GLOBAL SIGNAL OBSERVATORY</span>
		<span id="issue-date">{today}</span>
	</div>
	<div class="relative flex items-center justify-between py-6 sm:py-10 border-b border-ink gap-3 sm:gap-4">
		<button id="menu-toggle" type="button" class="md:hidden flex items-center justify-center w-9 h-9 -ml-2 shrink-0" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation">
			<span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
		</button>
		<div class="hidden md:block w-32 text-[10px] mono text-muted leading-relaxed">INDEPENDENT<br />BY DESIGN.</div>
		<a href="/" class="flex-1 min-w-0 text-center" aria-label="The Trend Times home">
			<div class="masthead display text-[clamp(19px,6.1vw,78px)] md:text-[clamp(44px,5.5vw,78px)] leading-none font-semibold tracking-[-.065em] whitespace-nowrap">THE TREND TIMES</div>
			<div class="text-[9px] sm:text-[11px] tracking-[.15em] sm:tracking-[.25em] uppercase mt-2.5 text-muted">Signals, Not Noise.</div>
		</a>
		<div class="hidden md:flex w-32 justify-end">
			<a href={`${p}#newsletter`} class="text-[10px] mono uppercase border border-ink rounded-full px-4 py-2.5 hover:bg-ink hover:text-white">Subscribe ↗</a>
		</div>
		<a href={`${p}#newsletter`} class="md:hidden shrink-0 text-[10px] uppercase mono underline underline-offset-4 py-2">Join ↗</a>
	</div>
	<nav class="hidden md:flex items-center justify-center gap-7 lg:gap-12 py-4 border-b hairline text-[11px] font-semibold tracking-[.12em] uppercase" aria-label="Primary">
		<a href={`${p}#latest`} data-nav-filter="all" class="hover:text-rust">Latest Intelligence</a>
		<a href={`${p}#latest`} data-nav-filter="agents" class="hover:text-rust">AI Agents</a>
		<a href={`${p}#latest`} data-nav-filter="saas" class="hover:text-rust">Micro-SaaS</a>
		<a href={`${p}#latest`} data-nav-filter="sentiment" class="hover:text-rust">Raw Sentiment</a>
		<a href={`${p}#market`} class="hover:text-rust">Market Signals</a>
		<a href="/about/" class="hover:text-rust">Our Method</a>
	</nav>
	<nav id="mobile-menu" class="menu-panel md:hidden border-b hairline py-2 text-[13px] font-semibold uppercase tracking-wider" aria-label="Mobile" hidden>
		<a href={`${p}#latest`} data-nav-filter="all" class="mobile-link">Latest Intelligence <span aria-hidden="true">↗</span></a>
		<a href={`${p}#latest`} data-nav-filter="agents" class="mobile-link">AI Agents <span aria-hidden="true">↗</span></a>
		<a href={`${p}#latest`} data-nav-filter="saas" class="mobile-link">Micro-SaaS <span aria-hidden="true">↗</span></a>
		<a href={`${p}#latest`} data-nav-filter="sentiment" class="mobile-link">Raw Sentiment <span aria-hidden="true">↗</span></a>
		<a href={`${p}#market`} class="mobile-link">Market Signals <span aria-hidden="true">↗</span></a>
		<a href="/about/" class="mobile-link">Our Method <span aria-hidden="true">↗</span></a>
		<a href="/blog/" class="mobile-link">Archive <span aria-hidden="true">↗</span></a>
	</nav>
</header>
